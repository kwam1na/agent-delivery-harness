{
  "schemaVersion": "delivery-harness-pre-cutover-oracle/1",
  "frozen": true,
  "capturedAt": "2026-08-31",
  "comparisonAuthority": "npm run check plus the delivery-harness gate loop (prepare, review-context, submit-evidence, gate, record, verify) and the hosted checks in .github/workflows",
  "description": "Immutable pre-cutover truth for this repository's own policy projection: the phase order, per-candidate-class activation, and blocker vocabulary of the unchanged delivery authority, captured before any managed-policy comparison. scripts/policy-projection-check.ts pins this file's digest, so recharacterizing the pre-cutover truth is a deliberate two-place edit rather than a quiet drift.",
  "selfApplication": {
    "position": "This repository's policy governs deliveries into the repository that implements the policy compiler. The direction of authority is: the compiled policy that judges a delivery is the trusted pre-run copy bound at policy-bind time, and the compiler bytes that produced it are the pinned composition generation the product was installed from — never the candidate worktree. A candidate edit to .agents/policy/, to delivery/personas/, or to packages/kernel/src/policy/ is therefore a proposal for a future owner-approved policy generation.",
    "enforcedBy": [
      "packages/kernel/src/policy/compile.ts checkBoundPolicy - only the exact bytes whose digest was bound judge this delivery",
      "packages/kernel/src/facade/managed-delivery.ts - reviewer charters and the trusted sensor are read from the base ref, not the candidate tree",
      "packages/kernel/src/substrate/installer.ts - the composition generation root is digest-addressed and installed read-only outside the repository"
    ],
    "sensorPosture": "scripts/policy-projection-check.ts deliberately compiles through the CANDIDATE tree's compiler. It is a read-only comparison sensor, not delivery authority: recompiling in-tree is what makes a compiler change that alters this repository's compiled policy visible as a two-place edit instead of silent drift."
  },
  "phaseVector": {
    "aggregateEntrypoints": ["check", "release-checks-workflow"],
    "orderedPhases": [
      { "phase": "prepare", "command": "delivery-harness prepare" },
      { "phase": "review-context", "command": "delivery-harness review-context" },
      { "phase": "submit-evidence", "command": "delivery-harness submit-evidence" },
      { "phase": "gate", "command": "delivery-harness gate" },
      { "phase": "record", "command": "delivery-harness record" },
      { "phase": "verify", "command": "delivery-harness verify" }
    ],
    "standaloneCommands": ["check", "managed", "maintain"],
    "checkSuiteConstituents": ["typecheck", "sensor", "sensor:cli", "test"],
    "recordWrittenOnlyAfterGate": true
  },
  "activationVector": {
    "gateId": "delivery-harness.pr-admission",
    "authoritativeGateSetInvariant": "Every candidate class runs the identical ordered delivery-loop phases and the identical always-active sensor set; activation varies only in the release-surface sensors that the release-checks workflow's path filters select.",
    "obligations": {
