  "blockerVector": {
    "preparationFailureClasses": ["missing", "invalid", "wiring_mismatch", "base_changed", "stale"],
    "deliveryRecordDriftClasses": [
      "deliverable_identity_changed",
      "base_ref_changed",
      "base_tip_moved",
      "merge_base_moved"
    ],
    "seededFailingCandidates": [
      {
        "id": "preparation-receipt-missing",
        "surface": "delivery-harness gate (preparation receipt evaluation)",
        "expectedFailureClass": "missing"
      },
      {
        "id": "harness-config-changed-after-preparation",
        "surface": "delivery-harness gate (preparation receipt evaluation)",
        "expectedFailureClass": "wiring_mismatch",
        "note": "harness.config.ts is this repository's declared preparationWiringPaths entry, so editing the gate after preparing invalidates the receipt"
      },
      {
        "id": "base-advanced-after-preparation",
        "surface": "delivery-harness gate (preparation receipt evaluation)",
        "expectedFailureClass": "base_changed"
      },
      {
        "id": "candidate-changed-after-preparation",
        "surface": "delivery-harness gate (preparation receipt evaluation)",
        "expectedFailureClass": "stale"
      },
      {
        "id": "review-evidence-missing",
        "obligation": "review.green",
        "expectedFindingCode": "review_evidence_missing",
        "humanWaivable": true
      },
      {
        "id": "review-evidence-bound-to-another-candidate",
        "obligation": "review.green",
        "expectedFindingCode": "stale_evidence",
        "humanWaivable": true
      },
      {
        "id": "review-evidence-not-green",
        "obligation": "review.green",
        "expectedFindingCode": "evidence_not_green",
        "humanWaivable": true
      },
      {
        "id": "evidence-record-malformed",
        "obligation": "review.green",
        "expectedFindingCode": "malformed_record",
        "humanWaivable": false
      },
      {
        "id": "evidence-from-unregistered-provider",
        "obligation": "review.green",
        "expectedFindingCode": "unknown_provider",
        "humanWaivable": false
      },
      {
        "id": "delivery-record-missing-on-pull-request",
        "surface": ".github/workflows/gate.yml (packages/action verify mode)",
        "expectedFailure": "fail-closed typed blocker naming the missing record"
      },
      {
        "id": "delivery-record-bound-to-a-superseded-candidate",
        "surface": ".github/workflows/gate.yml (packages/action verify mode)",
        "expectedDriftClass": "deliverable_identity_changed"
      },
      {
        "id": "base-moved-under-a-recorded-candidate",
        "surface": ".github/workflows/gate.yml (packages/action verify mode)",
        "expectedDriftClass": "base_tip_moved",
        "note": "this repository's deliveryRecordVerification.baseMovement policy is stale"
      },
      {
        "id": "conformance-kit-regenerates-differently",
        "surface": ".github/workflows/ci.yml (bun leg: diff -r packages/conformance/vectors)",
        "expectedFailure": "nonzero-exit",
        "remediation": "npm run kit:generate"
      },
      {
        "id": "unregistered-cli-command",
        "surface": "npm run sensor:cli",
        "expectedFailure": "nonzero-exit"
      },
      {
        "id": "kernel-imports-the-cli",
        "surface": "npm run sensor",
        "expectedFailure": "nonzero-exit"
      },
      {
        "id": "package-version-drift",
        "surface": "scripts/check-release.ts",
        "expectedFailure": "nonzero-exit"
      },
      {
        "id": "published-package-imports-an-undeclared-sibling",
        "surface": "npm run sensor:standalone",
        "expectedFailure": "nonzero-exit"
      }
    ],
