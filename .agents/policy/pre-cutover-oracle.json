  "aggregateExclusions": [
    {
      "entrypoint": "check",
      "reason": "npm run check chains typecheck, the import-boundary sensor, the CLI-inventory sensor, and the test suite; each of those is a leaf, so registering the aggregate would count them twice and hide which one refused."
    },
    {
      "entrypoint": "release-checks-workflow",
      "reason": ".github/workflows/release.yml chains the static release sensor, five publish dry-runs, and the standalone-install sensor; it is the comparison authority for the release surface, never a leaf."
    }
