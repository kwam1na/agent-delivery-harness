{
  "description": "A pull_request_target delivery. Refused by name: that event runs with the base repository's privileges against a head this Action would then be asked to trust.",
  "env": {
    "CI": "true",
    "GITHUB_ACTIONS": "true",
    "GITHUB_EVENT_NAME": "pull_request_target",
    "GITHUB_EVENT_PATH": "{{EVENT_PATH}}",
    "GITHUB_WORKSPACE": "{{WORKSPACE}}",
    "GITHUB_REPOSITORY": "kwam1na/agent-delivery-harness",
    "GITHUB_SHA": "{{BASE_SHA}}",
    "GITHUB_REF": "refs/heads/main"
  },
  "event": {
    "action": "opened",
    "number": 42,
    "pull_request": {
      "number": 42,
      "draft": false,
      "head": { "sha": "{{HEAD_SHA}}", "ref": "codex/feature" },
      "base": { "sha": "{{BASE_SHA}}", "ref": "main" }
    },
    "repository": { "full_name": "kwam1na/agent-delivery-harness", "default_branch": "main" }
  }
}
