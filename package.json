{
  "name": "delivery-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed merge admission for AI coding agents",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.vendored.json",
    "sensor": "node --import tsx scripts/check-import-boundaries.ts",
    "sensor:cli": "node --import tsx scripts/check-cli-inventory.ts",
    "kit:generate": "node --import tsx packages/conformance/src/generate.ts packages/conformance/vectors",
    "test": "vitest run",
    "check": "npm run typecheck && npm run sensor && npm run sensor:cli && npm run test"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
