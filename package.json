{
  "name": "delivery-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed merge admission for AI coding agents",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "harness": "node --import tsx packages/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.vendored.json",
    "sensor": "node --import tsx scripts/check-import-boundaries.ts",
    "sensor:cli": "node --import tsx scripts/check-cli-inventory.ts",
    "sensor:standalone": "node --import tsx scripts/check-standalone-install.ts",
    "sensor:policy": "node --import tsx scripts/policy-projection-check.ts",
    "policy:recompile": "node --import tsx scripts/recompile-policy-snapshot.ts",
    "review:evidence": "node --import tsx scripts/emit-review-evidence.ts",
    "qualify:provider": "node --import tsx scripts/qualify-agent-skills-provider.ts",
    "qualify:product": "node --import tsx scripts/qualify-product.ts",
    "kit:generate": "node --import tsx packages/conformance/src/generate.ts packages/conformance/vectors",
    "test": "vitest run",
    "check": "npm run typecheck && npm run sensor && npm run sensor:cli && npm run test"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
